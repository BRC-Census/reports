#!/usr/bin/env bash
set -euo pipefail

year="${1:?usage: bin/add-year <year> [landing page link text]}"
label="${2:-$year Population Report}"
cd "$(dirname "$0")/.."
dir="public/$year"
[ -f "$dir/index.html" ] || { echo "error: $dir/index.html not found" >&2; exit 1; }

BASE=$(cat <<'EOF'
<script>/* subdir-base */(function(p){if(!/\/$|\.[A-Za-z0-9]+$/.test(p))document.write('<base href="'+p+'/">');})(location.pathname);</script>
EOF
)
PATCH='<script src="../patch.js"></script>'
ICON='<link rel="icon" href="../favicon.ico"><link rel="apple-touch-icon" href="../apple-touch-icon.png">'
export BASE PATCH ICON

perl -0pi -e 's{<head>(\r?\n)}{<head>$1$ENV{BASE}$1} unless /subdir-base/' "$dir/index.html"
for f in "$dir"/*.html; do
  grep -q 'rel="[^"]*icon' "$f" || perl -0pi -e 's{(patch\.js"></script>\r?\n|<head>\r?\n)}{$1$ENV{ICON}\n}' "$f"
done
for f in "$dir"/*.html; do
  perl -0pi -e '
    next if /patch\.js/;
    s{(subdir-base.*?</script>)(\r?\n)}{$1$2$ENV{PATCH}$2}s
      or s{<head>(\r?\n)}{<head>$1$ENV{PATCH}$1};
  ' "$f"
done

if ! grep -q "href=\"$year/\"" public/index.html; then
  LI="<li><a href=\"$year/\">$label</a></li>" perl -0pi -e 's{(<ul class="reports">\n)(\s*)}{$1$2$ENV{LI}\n$2}' public/index.html
fi

missing=$(
  for f in "$dir"/*.html; do
    grep -oE '(href|src)="[^"#:?]+"' "$f" | sed 's/^[a-z]*="//; s/"$//' | sort -u | while read -r u; do
      case "$u" in *"'"*|../*) continue ;; esac
      [ -e "$dir/$u" ] || echo "missing: $dir/$u (referenced by $(basename "$f"))"
    done
  done | sort -u
)
[ -z "$missing" ] || echo "$missing" >&2

echo "subdir-base:  $(grep -l subdir-base "$dir/index.html" | wc -l | tr -d ' ')/1 index.html"
echo "patch.js:     $(grep -l patch.js "$dir"/*.html | wc -l | tr -d ' ')/$(ls "$dir"/*.html | wc -l | tr -d ' ') pages"
echo "landing page: $(grep -c "href=\"$year/\"" public/index.html) link"
[ -z "$missing" ] || { echo "error: fix the missing files above (copy the whole build)" >&2; exit 1; }
